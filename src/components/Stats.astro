---
interface Props {
  items: { value: string; label: string; note?: string }[];
}

const { items } = Astro.props;
---

<div
  class="not-prose my-8 grid grid-cols-1 gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-4"
>
  {
    items.map((item) => (
      <div class="flex flex-col gap-1 border-l-2 border-blue-600 pl-4 dark:border-blue-400">
        <span class="text-3xl font-semibold text-zinc-900 dark:text-zinc-50">
          {item.value}
        </span>
        <span class="text-sm text-zinc-700 dark:text-zinc-300">
          {item.label}
        </span>
        {item.note && (
          <span class="text-xs text-zinc-500 dark:text-zinc-400">
            {item.note}
          </span>
        )}
      </div>
    ))
  }
</div>
