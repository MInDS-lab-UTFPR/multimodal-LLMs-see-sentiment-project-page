---
import { Picture } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  quotes: string[];
  cues: string[];
  human: string[];
  truth: string;
  predicted: string;
}

const { src, alt, quotes, cues, human, truth, predicted } = Astro.props;
const correct = truth === predicted;
---

<div
  class="not-prose grid grid-cols-1 gap-x-6 gap-y-4 border-t border-zinc-200 py-6 sm:grid-cols-[7rem_1fr] dark:border-zinc-700"
>
  <div class="flex flex-col gap-2">
    <Picture
      class="aspect-square w-28 rounded-lg object-cover"
      src={src}
      alt={alt}
      width={224}
      height={224}
      formats={["avif"]}
      fit="cover"
    />
    <span
      class:list={[
        "inline-flex w-fit items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-medium",
        correct
          ? "bg-green-100 text-green-900 dark:bg-green-900/40 dark:text-green-100"
          : "bg-amber-100 text-amber-900 dark:bg-amber-900/40 dark:text-amber-100",
      ]}
    >
      {correct ? "✓" : "✗"}
      {predicted}
    </span>
  </div>

  <div class="flex flex-col gap-3 text-base">
    <p class="text-zinc-700 italic dark:text-zinc-300">
      {quotes.map((q, i) => <span>{i > 0 && " … "}“{q}”</span>)}
    </p>

    <div class="flex flex-col gap-2 text-sm">
      <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
        <span class="w-36 shrink-0 text-zinc-500 dark:text-zinc-400"
          >Cues in the description</span
        >
        <span class="flex flex-wrap gap-1.5">
          {
            cues.map((c) => (
              <span class="rounded bg-blue-50 px-1.5 py-0.5 text-blue-900 dark:bg-blue-950 dark:text-blue-100">
                {c}
              </span>
            ))
          }
        </span>
      </div>
      <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
        <span class="w-36 shrink-0 text-zinc-500 dark:text-zinc-400"
          >Human perception tags</span
        >
        <span class="flex flex-wrap gap-1.5">
          {
            human.map((h) => (
              <span class="rounded bg-zinc-100 px-1.5 py-0.5 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300">
                {h}
              </span>
            ))
          }
        </span>
      </div>
      <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
        <span class="w-36 shrink-0 text-zinc-500 dark:text-zinc-400"
          >Ground truth</span
        >
        <span class="text-zinc-700 dark:text-zinc-300">{truth}</span>
      </div>
    </div>
  </div>
</div>
